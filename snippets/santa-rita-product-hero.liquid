{% liquid
  assign product = closest.product | default: product
  assign variant = product.selected_or_first_available_variant
  if variant.available == false and product.available
    assign variant = product.first_available_variant
  endif
  assign image = variant.featured_image | default: product.featured_image
  assign breadcrumb_collection = blank
  assign cepa_metafield = product.metafields.custom['cepa']
  assign cc_metafield = product.metafields.custom['cc']
  assign varietal_metafield = product.metafields.custom['varietal']
  assign subtitle_metafield = product.metafields.custom['subtitle']
  assign cc_value = cc_metafield.value | default: cc_metafield
  assign cc_text = cc_value | append: '' | strip
  assign cc_text_downcase = cc_text | downcase
  assign cc_number = cc_text_downcase | remove: 'cc' | remove: 'c.c' | remove: '.' | remove: ',' | remove: ' ' | plus: 0
  assign has_unit_presentation = false
  assign has_box_presentation = false
  assign rating = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count
  assign rating_count_number = rating_count | plus: 0
  assign show_rating = false
  assign description = product.description | strip_html
  assign product_form_id = 'SantaRitaProductHeroForm-' | append: section.id
  assign presentation_group_name = 'santa-rita-product-presentation-' | append: section.id | append: '-' | append: product.id
  assign wpd_product_collection_ids = product.collections | map: 'id' | join: ','

  assign rating_number = rating | times: 1.0
  assign filled_stars = rating_number | round
  if rating_count_number > 0 and rating != blank
    assign show_rating = true
  endif
  assign can_add_to_cart = variant.available
  assign add_to_cart_text = 'Agregar'
  assign product_variant_media = ''

  capture cepa_label
    if cepa_metafield.type contains 'list.'
      assign cepa_separator = ''
      for cepa_item in cepa_metafield.value
        assign cepa_item_label = cepa_item.title.value | default: cepa_item.title | default: cepa_item.name.value | default: cepa_item.name | default: cepa_item.label.value | default: cepa_item.label | default: cepa_item
        if cepa_item_label != blank
          echo cepa_separator
          echo cepa_item_label
          assign cepa_separator = ', '
        endif
      endfor
    elsif cepa_metafield != blank
      echo cepa_metafield.value | default: cepa_metafield
    endif
  endcapture

  assign cepa_label = cepa_label | strip

  capture subtitle
    if cepa_label != blank
      echo cepa_label
    elsif varietal_metafield != blank
      echo varietal_metafield.value | default: varietal_metafield
    elsif subtitle_metafield != blank
      echo subtitle_metafield.value | default: subtitle_metafield
    elsif section.settings.product_hero_subtitle_override != blank
      echo section.settings.product_hero_subtitle_override
    else
      echo product.type
    endif
  endcapture

  assign subtitle = subtitle | strip

  if image != blank
    assign product_variant_media = image | image_url: width: 120
  endif

  unless can_add_to_cart
    assign add_to_cart_text = 'products.product.sold_out' | t
  endunless

  for product_collection in product.collections
    if product_collection.handle == 'vinos' or product_collection.title == 'Vinos'
      assign breadcrumb_collection = product_collection
      break
    endif
  endfor

  assign breadcrumb_collection = breadcrumb_collection | default: product.collections.first

  for presentation_variant in product.variants
    assign presentation_units_metafield = presentation_variant.metafields.custom.unidades_por_caja
    assign presentation_units_value = presentation_units_metafield.value | default: presentation_units_metafield
    assign presentation_units = presentation_units_value | default: 1 | plus: 0

    if presentation_units <= 1
      assign has_unit_presentation = true
    else
      assign has_box_presentation = true
    endif

    if has_unit_presentation and has_box_presentation
      break
    endif
  endfor
%}

{% capture presentation_discount_badges %}
  {% for presentation_variant in product.variants %}
    {% liquid
      assign presentation_discount_percent = 0

      if presentation_variant.compare_at_price > presentation_variant.price
        assign presentation_discount_value = presentation_variant.compare_at_price | minus: presentation_variant.price
        assign presentation_discount_percent = presentation_discount_value | times: 100 | divided_by: presentation_variant.compare_at_price | round
      endif
    %}

    {% if presentation_discount_percent > 0 %}
      <span
        class="santa-rita-product-hero__discount"
        data-sr-product-discount="{{ presentation_variant.id }}"
        {% unless presentation_variant.id == variant.id %}
          hidden
        {% endunless %}
      >
        -{{ presentation_discount_percent }}%
      </span>
    {% endif %}
  {% endfor %}
{% endcapture %}

{% capture presentation_price_panels %}
  {% for presentation_variant in product.variants %}
    <div
      class="santa-rita-product-hero__price-panel"
      data-sr-product-price-panel="{{ presentation_variant.id }}"
      data-wsh-product-id="{{ product.id }}"
      data-wsh-variant-id="{{ presentation_variant.id }}"
      {% unless presentation_variant.id == variant.id %}
        hidden
      {% endunless %}
    >
      <strong
        class="sr-wsh-price price"
        data-wpd-product-handle="{{ product.handle }}"
        data-wpd-variant-id="{{ presentation_variant.id }}"
        data-wpd-variant-price="{{ presentation_variant.price }}"
        data-wpd-variant-compare-at-price="{{ presentation_variant.compare_at_price }}"
        data-wpd-product-collection-ids="{{ wpd_product_collection_ids }}"
        data-wpd-product-id="{{ product.id }}"
      >
        {{- presentation_variant.price | money -}}
      </strong>
      {% if presentation_variant.compare_at_price > presentation_variant.price %}
        <s class="sr-wsh-compare-price compare-at-price data-wpd-hide">{{ presentation_variant.compare_at_price | money }}</s>
      {% endif %}
    </div>
  {% endfor %}
{% endcapture %}

{% capture presentation_options %}
  {% unless has_unit_presentation %}
    <div class="santa-rita-product-hero__presentation-option">
      <span class="santa-rita-product-hero__presentation-label santa-rita-product-hero__presentation-label--disabled">
        <span class="santa-rita-product-hero__presentation-count">1 u.</span>
        <span class="santa-rita-product-hero__presentation-unavailable">No disponible</span>
      </span>
    </div>
  {% endunless %}

  {% for presentation_variant in product.variants %}
    {% liquid
      assign presentation_units_metafield = presentation_variant.metafields.custom.unidades_por_caja
      assign presentation_units_value = presentation_units_metafield.value | default: presentation_units_metafield
      assign presentation_units = presentation_units_value | default: 1 | plus: 0

      if presentation_units < 1
        assign presentation_units = 1
      endif

      assign presentation_input_id = 'santa-rita-product-presentation-' | append: section.id | append: '-' | append: presentation_variant.id
      assign presentation_title_metafield = presentation_variant.metafields.custom.titulo_presentacion
      assign presentation_title = presentation_title_metafield.value | default: presentation_title_metafield

      if presentation_units <= 1
        assign presentation_label = '1 u.'
      else
        assign presentation_label = presentation_units | append: 'u.'
      endif

      if presentation_title != blank
        assign presentation_label = presentation_title
      endif
    %}

    {% if presentation_units <= 1 %}
      <div class="santa-rita-product-hero__presentation-option">
        <input
          id="{{ presentation_input_id }}"
          class="santa-rita-product-hero__presentation-radio"
          data-sr-product-variant-id="{{ presentation_variant.id }}"
          data-sr-product-variant-available="{{ presentation_variant.available }}"
          type="radio"
          name="{{ presentation_group_name }}"
          value="{{ presentation_variant.id }}"
          {% if presentation_variant.id == variant.id %}
            checked
          {% endif %}
          {% unless presentation_variant.available %}
            disabled
          {% endunless %}
        >
        <label class="santa-rita-product-hero__presentation-label" for="{{ presentation_input_id }}">
          <span class="santa-rita-product-hero__presentation-count">{{ presentation_label }}</span>
          {% if presentation_variant.available %}
            <span
              class="santa-rita-product-hero__presentation-price sr-wsh-price price"
              data-wsh-product-id="{{ product.id }}"
              data-wsh-variant-id="{{ presentation_variant.id }}"
              data-wpd-product-handle="{{ product.handle }}"
              data-wpd-variant-id="{{ presentation_variant.id }}"
              data-wpd-variant-price="{{ presentation_variant.price }}"
              data-wpd-variant-compare-at-price="{{ presentation_variant.compare_at_price }}"
              data-wpd-product-collection-ids="{{ wpd_product_collection_ids }}"
              data-wpd-product-id="{{ product.id }}"
            >
              {{- presentation_variant.price | money -}}
            </span>
            {% if presentation_variant.compare_at_price > presentation_variant.price %}
              <s
                class="santa-rita-product-hero__presentation-compare sr-wsh-compare-price compare-at-price data-wpd-hide"
                data-wsh-product-id="{{ product.id }}"
                data-wsh-variant-id="{{ presentation_variant.id }}"
              >
                {{- presentation_variant.compare_at_price | money -}}
              </s>
            {% endif %}
            <span class="santa-rita-product-hero__presentation-check" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none">
                <circle cx="7" cy="7" r="7" fill="currentColor"/>
                <path d="M4 7.15L6.05 9.2L10.1 4.95" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          {% else %}
            <span class="santa-rita-product-hero__presentation-unavailable">No disponible</span>
          {% endif %}
        </label>
      </div>
    {% endif %}
  {% endfor %}

  {% for presentation_variant in product.variants %}
    {% liquid
      assign presentation_units_metafield = presentation_variant.metafields.custom.unidades_por_caja
      assign presentation_units_value = presentation_units_metafield.value | default: presentation_units_metafield
      assign presentation_units = presentation_units_value | default: 1 | plus: 0

      if presentation_units < 1
        assign presentation_units = 1
      endif

      assign presentation_input_id = 'santa-rita-product-presentation-' | append: section.id | append: '-' | append: presentation_variant.id
      assign presentation_title_metafield = presentation_variant.metafields.custom.titulo_presentacion
      assign presentation_title = presentation_title_metafield.value | default: presentation_title_metafield
      assign presentation_label = presentation_units | append: 'u.'

      if presentation_title != blank
        assign presentation_label = presentation_title
      endif
    %}

    {% if presentation_units > 1 %}
      <div class="santa-rita-product-hero__presentation-option">
        <input
          id="{{ presentation_input_id }}"
          class="santa-rita-product-hero__presentation-radio"
          data-sr-product-variant-id="{{ presentation_variant.id }}"
          data-sr-product-variant-available="{{ presentation_variant.available }}"
          type="radio"
          name="{{ presentation_group_name }}"
          value="{{ presentation_variant.id }}"
          {% if presentation_variant.id == variant.id %}
            checked
          {% endif %}
          {% unless presentation_variant.available %}
            disabled
          {% endunless %}
        >
        <label class="santa-rita-product-hero__presentation-label" for="{{ presentation_input_id }}">
          <span class="santa-rita-product-hero__presentation-count">{{ presentation_label }}</span>
          {% if presentation_variant.available %}
            <span
              class="santa-rita-product-hero__presentation-price sr-wsh-price price"
              data-wsh-product-id="{{ product.id }}"
              data-wsh-variant-id="{{ presentation_variant.id }}"
              data-wpd-product-handle="{{ product.handle }}"
              data-wpd-variant-id="{{ presentation_variant.id }}"
              data-wpd-variant-price="{{ presentation_variant.price }}"
              data-wpd-variant-compare-at-price="{{ presentation_variant.compare_at_price }}"
              data-wpd-product-collection-ids="{{ wpd_product_collection_ids }}"
              data-wpd-product-id="{{ product.id }}"
            >
              {{- presentation_variant.price | money -}}
            </span>
            {% if presentation_variant.compare_at_price > presentation_variant.price %}
              <s
                class="santa-rita-product-hero__presentation-compare sr-wsh-compare-price compare-at-price data-wpd-hide"
                data-wsh-product-id="{{ product.id }}"
                data-wsh-variant-id="{{ presentation_variant.id }}"
              >
                {{- presentation_variant.compare_at_price | money -}}
              </s>
            {% endif %}
            <span class="santa-rita-product-hero__presentation-check" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none">
                <circle cx="7" cy="7" r="7" fill="currentColor"/>
                <path d="M4 7.15L6.05 9.2L10.1 4.95" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          {% else %}
            <span class="santa-rita-product-hero__presentation-unavailable">No disponible</span>
          {% endif %}
        </label>
      </div>
    {% endif %}
  {% endfor %}

  {% unless has_box_presentation %}
    <div class="santa-rita-product-hero__presentation-option">
      <span class="santa-rita-product-hero__presentation-label santa-rita-product-hero__presentation-label--disabled">
        <span class="santa-rita-product-hero__presentation-count">6u.</span>
        <span class="santa-rita-product-hero__presentation-unavailable">No disponible</span>
      </span>
    </div>
  {% endunless %}
{% endcapture %}

{% capture liter_prices %}
  {% for presentation_variant in product.variants %}
    {% liquid
      assign presentation_units_metafield = presentation_variant.metafields.custom.unidades_por_caja
      assign presentation_units_value = presentation_units_metafield.value | default: presentation_units_metafield
      assign presentation_units = presentation_units_value | default: 1 | plus: 0
      assign presentation_liter_price = 0

      if presentation_units < 1
        assign presentation_units = 1
      endif

      if cc_number > 0
        assign presentation_liter_price = presentation_variant.price | times: 1000 | divided_by: cc_number | divided_by: presentation_units
      endif
    %}

    {% if presentation_liter_price > 0 %}
      <p
        class="santa-rita-product-hero__liter-price"
        data-sr-product-liter-price="{{ presentation_variant.id }}"
        data-wsh-product-id="{{ product.id }}"
        data-wsh-variant-id="{{ presentation_variant.id }}"
        {% unless presentation_variant.id == variant.id %}
          hidden
        {% endunless %}
      >
        Precio por litro <strong class="sr-wsh-liter-price">{{ presentation_liter_price | money }}</strong>
      </p>
    {% elsif presentation_variant.unit_price_measurement %}
      <p
        class="santa-rita-product-hero__liter-price"
        data-sr-product-liter-price="{{ presentation_variant.id }}"
        {% unless presentation_variant.id == variant.id %}
          hidden
        {% endunless %}
      >
        Precio por litro <strong>{% render 'unit-price', price: presentation_variant.unit_price, measurement: presentation_variant.unit_price_measurement %}</strong>
      </p>
    {% endif %}
  {% endfor %}
{% endcapture %}

<section
  class="santa-rita-product-hero color-{{ section.settings.color_scheme }}"
  data-wsh-product-id="{{ product.id }}"
  data-wsh-selected-variant-id="{{ variant.id }}"
>
  <div class="santa-rita-product-hero__inner">
    {% if section.settings.product_hero_show_breadcrumbs != false %}
      <nav class="santa-rita-product-hero__breadcrumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Inicio</a>
        <span aria-hidden="true">></span>
        {% if breadcrumb_collection != blank %}
          <a href="{{ breadcrumb_collection.url }}">Vinos</a>
        {% else %}
          <a href="{{ routes.all_products_collection_url }}">Vinos</a>
        {% endif %}
        <span aria-hidden="true">></span>
        <span>{{ product.title }}</span>
      </nav>
    {% endif %}

    <div class="santa-rita-product-hero__grid">
      <div class="santa-rita-product-hero__media">
        {% if image != blank %}
          {{
            image
            | image_url: width: 780
            | image_tag:
              class: 'santa-rita-product-hero__image',
              widths: '360, 520, 680, 780, 960',
              sizes: '(min-width: 990px) 420px, 70vw',
              loading: 'eager'
          }}
        {% else %}
          {{ 'product-apparel-1' | placeholder_svg_tag: 'santa-rita-product-hero__image santa-rita-product-hero__image--placeholder' }}
        {% endif %}
      </div>

      <div class="santa-rita-product-hero__details">
        {{ presentation_discount_badges }}

        <h1 class="santa-rita-product-hero__title">{{ product.title }}</h1>

        {% if subtitle != blank %}
          <p class="santa-rita-product-hero__subtitle">{{ subtitle }}</p>
        {% endif %}

        {% comment %}
        <pre
          class="santa-rita-product-hero__debug"
          data-santa-rita-product-debug
          hidden
        >product.id: {{ product.id }}
product.title: {{ product.title }}
product.type: {{ product.type }}
custom.cepa: {{ cepa_metafield }}
custom.cepa.value: {{ cepa_metafield.value }}
custom.varietal: {{ varietal_metafield }}
custom.varietal.value: {{ varietal_metafield.value }}
custom.subtitle: {{ subtitle_metafield }}
custom.subtitle.value: {{ subtitle_metafield.value }}
custom namespace:
{% for custom_metafield in product.metafields.custom %}
- {{ custom_metafield.first }}: {{ custom_metafield.last.value | default: custom_metafield.last }}
{% else %}
- no custom metafields exposed to Liquid
{% endfor %}
resolved subtitle: {{ subtitle }}</pre>
        <script>
          (() => {
            const isLocal = ['localhost', '127.0.0.1', '0.0.0.0'].includes(window.location.hostname);

            if (!isLocal) return;

            const debugElement = document.querySelector('[data-santa-rita-product-debug]');

            if (debugElement) {
              debugElement.hidden = false;
            }

            console.warn('Santa Rita product metafields debug', {
              productId: {{ product.id | json }},
              productTitle: {{ product.title | json }},
              productType: {{ product.type | json }},
              customCepa: {{ cepa_metafield | json }},
              customCepaValue: {{ cepa_metafield.value | json }},
              customVarietal: {{ varietal_metafield | json }},
              customVarietalValue: {{ varietal_metafield.value | json }},
              customSubtitle: {{ subtitle_metafield | json }},
              customSubtitleValue: {{ subtitle_metafield.value | json }},
              resolvedSubtitle: {{ subtitle | json }}
            });
          })();
        </script>
        {% endcomment %}

        {% if show_rating %}
          <div class="santa-rita-product-hero__rating" aria-label="{{ rating_number | round: 1 }} de 5 estrellas, {{ rating_count_number }} reseñas">
            <span class="santa-rita-product-hero__rating-number">{{ rating_number | round: 1 }}</span>
            <span class="santa-rita-product-hero__stars" aria-hidden="true">
              {% for index in (1..5) %}
                <span class="santa-rita-product-hero__star{% if index <= filled_stars %} is-filled{% endif %}">★</span>
              {% endfor %}
            </span>
            <span class="santa-rita-product-hero__rating-count">({{ rating_count_number }})</span>
          </div>
        {% endif %}

        <product-form-component
          data-section-id="{{ section.id }}"
          data-product-id="{{ product.id }}"
          data-product-url="{{ product.url }}"
          data-quantity-default="1"
          data-quantity-error-max="{{ 'products.product.quantity_error_max' | t }}"
          on:submit="/handleSubmit"
        >
          <div
            class="visually-hidden"
            aria-live="assertive"
            role="status"
            aria-atomic="true"
            ref="liveRegion"
          ></div>

          {% form 'product', product, id: product_form_id, class: 'santa-rita-product-hero__form', data-type: 'add-to-cart-form' %}
            <input
              type="hidden"
              name="id"
              ref="variantId"
              value="{{ variant.id }}"
            >
            <input type="hidden" name="quantity" value="1">

            <div
              class="santa-rita-product-hero__price"
              data-sr-product-price
              data-wsh-product-id="{{ product.id }}"
              data-wsh-selected-variant-id="{{ variant.id }}"
            >
              {{ presentation_price_panels }}
            </div>

            {% if presentation_options != blank %}
              <santa-rita-product-presentation-selector class="santa-rita-product-hero__presentations">
                <fieldset class="santa-rita-product-hero__presentation-options" aria-label="Presentación">
                  {{ presentation_options }}
                </fieldset>
              </santa-rita-product-presentation-selector>
            {% endif %}

            {% if liter_prices != blank %}
              <div class="santa-rita-product-hero__liter-prices" data-sr-product-liter-prices>
                {{ liter_prices }}
              </div>
            {% endif %}

            <add-to-cart-component
              ref="addToCartButtonContainer"
              data-product-variant-media="{{ product_variant_media }}"
              data-add-to-cart-animation="{{ settings.add_to_cart_animation }}"
            >
              <button
                type="submit"
                name="add"
                ref="addToCartButton"
                on:click="/handleClick"
                class="santa-rita-product-hero__add"
                {% unless can_add_to_cart %}
                  disabled
                {% endunless %}
              >
                {% if can_add_to_cart %}
                  <span class="santa-rita-product-hero__add-icon" aria-hidden="true">
                    {{ 'icon-add-to-cart.svg' | inline_asset_content }}
                  </span>
                {% endif %}
                <span>{{ add_to_cart_text }}</span>
              </button>
            </add-to-cart-component>
          {% endform %}
        </product-form-component>

        {% if description != blank %}
          <p class="santa-rita-product-hero__description">{{ description | truncatewords: 62 }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<script>
  if (!customElements.get('santa-rita-product-presentation-selector')) {
    customElements.define(
      'santa-rita-product-presentation-selector',
      class SantaRitaProductPresentationSelector extends HTMLElement {
        connectedCallback() {
          this.addEventListener('change', this.handleChange);
        }

        disconnectedCallback() {
          this.removeEventListener('change', this.handleChange);
        }

        handleChange = (event) => {
          const input = event.target;

          if (!(input instanceof HTMLInputElement) || !input.matches('[data-sr-product-variant-id]')) return;

          const form = this.closest('form');
          const productHero = this.closest('.santa-rita-product-hero');
          const variantInput = form?.querySelector('input[ref="variantId"]');
          const addButton = form?.querySelector('[ref="addToCartButton"]');
          const variantId = input.dataset.srProductVariantId;

          if (!variantId) return;

          if (variantInput instanceof HTMLInputElement) {
            variantInput.value = variantId;
          }

          productHero?.setAttribute('data-wsh-selected-variant-id', variantId);
          form?.querySelectorAll('[data-wsh-selected-variant-id]').forEach((element) => {
            element.setAttribute('data-wsh-selected-variant-id', variantId);
          });

          productHero?.querySelectorAll('[data-sr-product-price-panel]').forEach((panel) => {
            panel.hidden = panel.getAttribute('data-sr-product-price-panel') !== variantId;
          });

          productHero?.querySelectorAll('[data-sr-product-liter-price]').forEach((price) => {
            price.hidden = price.getAttribute('data-sr-product-liter-price') !== variantId;
          });

          productHero?.querySelectorAll('[data-sr-product-discount]').forEach((discount) => {
            discount.hidden = discount.getAttribute('data-sr-product-discount') !== variantId;
          });

          if (addButton instanceof HTMLButtonElement) {
            addButton.disabled = input.dataset.srProductVariantAvailable !== 'true';
          }
        };
      }
    );
  }
</script>

<style>
  .santa-rita-product-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #FFFCF7;
    color: #21191a;
  }

  .santa-rita-product-hero::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: clamp(220px, 33vw, 343px);
    z-index: -1;
    background: #fff7f1;
    clip-path: polygon(
      100% 21.817%,
      99.444% 22.578%,
      98.889% 23.339%,
      98.333% 24.096%,
      97.778% 24.853%,
      97.222% 25.605%,
      96.667% 26.352%,
      96.111% 27.095%,
      95.556% 27.831%,
      95% 28.559%,
      94.444% 29.271%,
      93.889% 29.966%,
      93.333% 30.641%,
      92.778% 31.295%,
