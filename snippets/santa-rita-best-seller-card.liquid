{% liquid
  assign product_type_downcase = product.type | downcase
  assign is_tour_product = false

  if product_type_downcase contains 'tour' or product.tags contains 'tour' or product.tags contains 'Tour'
    assign is_tour_product = true
  endif

  assign selected_variant = product.selected_or_first_available_variant
  assign has_unit_presentation = false
  assign has_box_presentation = false

  assign judgeme_rating = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value
  assign judgeme_rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count
  assign rating_number = judgeme_rating | times: 1.0
  assign rating_count_number = judgeme_rating_count | plus: 0
  assign filled_stars = rating_number | round
  assign show_rating = false

  if rating_count_number > 0 and judgeme_rating != blank
    assign show_rating = true
  endif

  assign location_metafield = product.metafields.custom.location
  assign location = ''

  if location_metafield != blank
    assign location_value = location_metafield.value
    assign location = location_value | default: location_metafield
  endif

  assign cepa_metafield = product.metafields.custom.cepa
  assign cc_metafield = product.metafields.custom.cc
  assign card_eyebrow = product.metafields.custom.card_eyebrow.value | default: product.metafields.custom.card_eyebrow
  assign cc_value = cc_metafield.value | default: cc_metafield
  assign cc_text = cc_value | append: '' | strip
  assign cc_text_downcase = cc_text | downcase
  assign cc_number = cc_text_downcase | remove: 'cc' | remove: 'c.c' | remove: '.' | remove: ',' | remove: ' ' | plus: 0

  if cc_text != blank and cc_text_downcase contains 'cc'
    assign cc_label = cc_text
  elsif cc_text != blank
    assign cc_label = cc_text | append: 'cc.'
  endif

  capture cepa_label
    if cepa_metafield.type contains 'list.'
      assign cepa_separator = ''
      for cepa_item in cepa_metafield.value
        assign cepa_item_label = cepa_item.title.value | default: cepa_item.title | default: cepa_item.name.value | default: cepa_item.name | default: cepa_item.label.value | default: cepa_item.label | default: cepa_item
        if cepa_item_label != blank
          echo cepa_separator
          echo cepa_item_label
          assign cepa_separator = ', '
        endif
      endfor
    elsif cepa_metafield != blank
      echo cepa_metafield.value | default: cepa_metafield
    endif
  endcapture

  assign cepa_label = cepa_label | strip
  assign eyebrow = cepa_label | default: card_eyebrow | default: product.type

  if cepa_label != blank and cc_label != blank
    assign eyebrow = cepa_label | append: ' - ' | append: cc_label
  endif

  assign card_uid = section.id | default: product.id | append: '-' | append: product.id
  assign wpd_product_collection_ids = product.collections | map: 'id' | join: ','

  for presentation_variant in product.variants
    assign presentation_units_metafield = presentation_variant.metafields.custom.unidades_por_caja
    assign presentation_units_value = presentation_units_metafield.value | default: presentation_units_metafield
    assign presentation_units = presentation_units_value | default: 1 | plus: 0

    if presentation_units <= 1
      assign has_unit_presentation = true
    else
      assign has_box_presentation = true
    endif

    if has_unit_presentation and has_box_presentation
      break
    endif
  endfor

%}

{% capture discount_badges %}
  {% for presentation_variant in product.variants %}
    {% liquid
      assign presentation_discount_percent = 0

      if presentation_variant.compare_at_price > presentation_variant.price
        assign presentation_discount_value = presentation_variant.compare_at_price | minus: presentation_variant.price
        assign presentation_discount_percent = presentation_discount_value | times: 100 | divided_by: presentation_variant.compare_at_price | round
      endif
    %}

    {% if presentation_discount_percent > 0 %}
      <span class="santa-rita-product-card__badge santa-rita-product-card__badge--discount santa-rita-product-card__badge--variant-{{ presentation_variant.id }}">-{{ presentation_discount_percent }}%</span>
    {% else %}
      <span class="santa-rita-product-card__badge santa-rita-product-card__badge--blank santa-rita-product-card__badge--variant-{{ presentation_variant.id }}"></span>
    {% endif %}

    {% capture variant_discount_style %}
      {{ variant_discount_style }}
      .santa-rita-product-card:has([data-card-variant-id='{{ presentation_variant.id }}']:checked) .santa-rita-product-card__badge--variant-{{ presentation_variant.id }} { display: inline-flex; }
    {% endcapture %}
  {% endfor %}
{% endcapture %}

{% capture presentation_options %}
  {% unless has_unit_presentation %}
    <div class="santa-rita-product-card__quantity-option">
      <span class="santa-rita-product-card__quantity-label santa-rita-product-card__quantity-label--disabled">
        <span class="santa-rita-product-card__quantity-count">1 u.</span>
        <span class="santa-rita-product-card__quantity-unavailable">No disponible</span>
      </span>
    </div>
  {% endunless %}

  {% for presentation_variant in product.variants %}
    {% liquid
      assign presentation_units_metafield = presentation_variant.metafields.custom.unidades_por_caja
      assign presentation_units_value = presentation_units_metafield.value | default: presentation_units_metafield
      assign presentation_units = presentation_units_value | default: 1 | plus: 0

      if presentation_units < 1
        assign presentation_units = 1
      endif

      assign presentation_compare_total = presentation_variant.compare_at_price
      assign presentation_input_id = 'santa-rita-card-variant-' | append: card_uid | append: '-' | append: presentation_variant.id
      assign presentation_title_metafield = presentation_variant.metafields.custom.titulo_presentacion
      assign presentation_title = presentation_title_metafield.value | default: presentation_title_metafield

      if presentation_units <= 1
        assign presentation_label = '1 u.'
      else
        assign presentation_label = presentation_units | append: 'u.'
      endif

      if presentation_title != blank
        assign presentation_label = presentation_title
      endif
    %}

    {% if presentation_units <= 1 %}
      <div class="santa-rita-product-card__quantity-option">
        <input
          id="{{ presentation_input_id }}"
          class="santa-rita-product-card__quantity-radio"
          data-card-variant-id="{{ presentation_variant.id }}"
          type="radio"
          name="id"
          value="{{ presentation_variant.id }}"
          {% if presentation_variant.id == selected_variant.id %}
            checked
          {% endif %}
          {% unless presentation_variant.available %}
            disabled
          {% endunless %}
        >
        <label class="santa-rita-product-card__quantity-label" for="{{ presentation_input_id }}">
          <span class="santa-rita-product-card__quantity-count">{{ presentation_label }}</span>
          {% if presentation_variant.available %}
            <span
              class="santa-rita-product-card__quantity-price sr-wsh-price price"
              data-wsh-product-id="{{ product.id }}"
              data-wsh-variant-id="{{ presentation_variant.id }}"
              data-wpd-product-handle="{{ product.handle }}"
              data-wpd-variant-id="{{ presentation_variant.id }}"
              data-wpd-variant-price="{{ presentation_variant.price }}"
              data-wpd-variant-compare-at-price="{{ presentation_variant.compare_at_price }}"
              data-wpd-product-collection-ids="{{ wpd_product_collection_ids }}"
              data-wpd-product-id="{{ product.id }}"
            >
              {{- presentation_variant.price | money -}}
            </span>
            {% if presentation_compare_total > presentation_variant.price %}
              <s
                class="santa-rita-product-card__quantity-compare sr-wsh-compare-price compare-at-price data-wpd-hide"
                data-wsh-product-id="{{ product.id }}"
                data-wsh-variant-id="{{ presentation_variant.id }}"
              >
                {{- presentation_compare_total | money -}}
              </s>
            {% endif %}
            <span class="santa-rita-product-card__quantity-check" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none">
                <circle cx="7" cy="7" r="7" fill="currentColor"/>
                <path d="M4 7.15L6.05 9.2L10.1 4.95" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          {% else %}
            <span class="santa-rita-product-card__quantity-unavailable">No disponible</span>
          {% endif %}
        </label>
      </div>
    {% endif %}
  {% endfor %}

  {% for presentation_variant in product.variants %}
    {% liquid
      assign presentation_units_metafield = presentation_variant.metafields.custom.unidades_por_caja
      assign presentation_units_value = presentation_units_metafield.value | default: presentation_units_metafield
      assign presentation_units = presentation_units_value | default: 1 | plus: 0

      if presentation_units < 1
        assign presentation_units = 1
      endif

      assign presentation_compare_total = presentation_variant.compare_at_price
      assign presentation_input_id = 'santa-rita-card-variant-' | append: card_uid | append: '-' | append: presentation_variant.id
      assign presentation_title_metafield = presentation_variant.metafields.custom.titulo_presentacion
      assign presentation_title = presentation_title_metafield.value | default: presentation_title_metafield
      assign presentation_label = presentation_units | append: 'u.'

      if presentation_title != blank
        assign presentation_label = presentation_title
      endif
    %}

    {% if presentation_units > 1 %}
      <div class="santa-rita-product-card__quantity-option">
        <input
          id="{{ presentation_input_id }}"
          class="santa-rita-product-card__quantity-radio"
          data-card-variant-id="{{ presentation_variant.id }}"
          type="radio"
          name="id"
          value="{{ presentation_variant.id }}"
          {% if presentation_variant.id == selected_variant.id %}
            checked
          {% endif %}
          {% unless presentation_variant.available %}
            disabled
          {% endunless %}
        >
        <label class="santa-rita-product-card__quantity-label" for="{{ presentation_input_id }}">
          <span class="santa-rita-product-card__quantity-count">{{ presentation_label }}</span>
          {% if presentation_variant.available %}
            <span
              class="santa-rita-product-card__quantity-price sr-wsh-price price"
              data-wsh-product-id="{{ product.id }}"
              data-wsh-variant-id="{{ presentation_variant.id }}"
              data-wpd-product-handle="{{ product.handle }}"
              data-wpd-variant-id="{{ presentation_variant.id }}"
              data-wpd-variant-price="{{ presentation_variant.price }}"
              data-wpd-variant-compare-at-price="{{ presentation_variant.compare_at_price }}"
              data-wpd-product-collection-ids="{{ wpd_product_collection_ids }}"
              data-wpd-product-id="{{ product.id }}"
            >
              {{- presentation_variant.price | money -}}
            </span>
            {% if presentation_compare_total > presentation_variant.price %}
              <s
                class="santa-rita-product-card__quantity-compare sr-wsh-compare-price compare-at-price data-wpd-hide"
                data-wsh-product-id="{{ product.id }}"
                data-wsh-variant-id="{{ presentation_variant.id }}"
              >
                {{- presentation_compare_total | money -}}
              </s>
            {% endif %}
            <span class="santa-rita-product-card__quantity-check" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none">
                <circle cx="7" cy="7" r="7" fill="currentColor"/>
                <path d="M4 7.15L6.05 9.2L10.1 4.95" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          {% else %}
            <span class="santa-rita-product-card__quantity-unavailable">No disponible</span>
          {% endif %}
        </label>
      </div>
    {% endif %}
  {% endfor %}

  {% unless has_box_presentation %}
    <div class="santa-rita-product-card__quantity-option">
      <span class="santa-rita-product-card__quantity-label santa-rita-product-card__quantity-label--disabled">
        <span class="santa-rita-product-card__quantity-count">6u.</span>
        <span class="santa-rita-product-card__quantity-unavailable">No disponible</span>
      </span>
    </div>
  {% endunless %}
{% endcapture %}

{% capture liter_prices %}
  {% for presentation_variant in product.variants %}
    {% liquid
      assign presentation_units_metafield = presentation_variant.metafields.custom.unidades_por_caja
      assign presentation_units_value = presentation_units_metafield.value | default: presentation_units_metafield
      assign presentation_units = presentation_units_value | default: 1 | plus: 0
      assign presentation_liter_price = 0

      if presentation_units < 1
        assign presentation_units = 1
      endif

      if cc_number > 0
        assign presentation_liter_price = presentation_variant.price | times: 1000 | divided_by: cc_number | divided_by: presentation_units
      endif
    %}

    {% if cc_number > 0 %}
      <p
        class="santa-rita-product-card__liter-price santa-rita-product-card__liter-price--{{ presentation_variant.id }}"
        data-wsh-product-id="{{ product.id }}"
        data-wsh-variant-id="{{ presentation_variant.id }}"
      >
        Precio por litro <strong class="sr-wsh-liter-price">{{ presentation_liter_price | money }}</strong>
      </p>
      {% capture variant_liter_price_style %}
        {{ variant_liter_price_style }}
        .santa-rita-product-card__form:has([data-card-variant-id='{{ presentation_variant.id }}']:checked) .santa-rita-product-card__liter-price--{{ presentation_variant.id }} { display: block; }
      {% endcapture %}
    {% elsif presentation_variant.unit_price_measurement %}
      <p class="santa-rita-product-card__liter-price santa-rita-product-card__liter-price--{{ presentation_variant.id }}">
        Precio por litro <strong>{% render 'unit-price', price: presentation_variant.unit_price, measurement: presentation_variant.unit_price_measurement %}</strong>
      </p>
      {% capture variant_liter_price_style %}
        {{ variant_liter_price_style }}
        .santa-rita-product-card__form:has([data-card-variant-id='{{ presentation_variant.id }}']:checked) .santa-rita-product-card__liter-price--{{ presentation_variant.id }} { display: block; }
      {% endcapture %}
    {% endif %}
  {% endfor %}
{% endcapture %}

{% style %}
  .santa-rita-product-card__liter-prices .santa-rita-product-card__liter-price {
    display: none;
  }

  .santa-rita-product-card__badges .santa-rita-product-card__badge {
    display: none;
  }

  .santa-rita-product-card__quantity-radio:disabled + .santa-rita-product-card__quantity-label,
  .santa-rita-product-card__quantity-label--disabled {
    border-color: #eee8e2;
    background: #f8f5f1;
    color: #8a7b81;
    cursor: default;
  }

  .santa-rita-product-card__quantity-radio:disabled + .santa-rita-product-card__quantity-label .santa-rita-product-card__quantity-count,
  .santa-rita-product-card__quantity-label--disabled .santa-rita-product-card__quantity-count,
  .santa-rita-product-card__quantity-unavailable {
    color: #8a7b81;
    font-weight: 600;
  }

  {{ variant_discount_style }}
  {{ variant_liter_price_style }}
{% endstyle %}

{% unless is_tour_product %}
  <article
    class="santa-rita-product-card"
    data-wsh-product-id="{{ product.id }}"
    data-wsh-selected-variant-id="{{ selected_variant.id }}"
  >
  <div class="santa-rita-product-card__badges">
    {{ discount_badges }}
  </div>

  <div class="santa-rita__product-image">
    <a href="{{ product.url }}" class="santa-rita-product-card__media" aria-label="{{ product.title | escape }}">
      {% if product.featured_image != blank %}
        {{
          product.featured_image
          | image_url: width: 420
          | image_tag:
            widths: '240, 320, 420, 560',
            sizes: '(min-width: 990px) 260px, 82vw',
            loading: 'lazy',
            class: 'santa-rita-product-card__image'
        }}
      {% else %}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'santa-rita-product-card__image santa-rita-product-card__image--placeholder' }}
      {% endif %}
    </a>

    {% if show_rating %}
      <div class="santa-rita-product-card__rating" aria-label="{{ rating_number | round: 1 }} de 5 estrellas, {{ rating_count_number }} reseñas">
        <div class="santa-rita__star-group" aria-hidden="true">
          {% for i in (1..5) %}
            <span>
              <svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 9 9" fill="none">
                <g clip-path="url(#clip0_1568_13293_{{ card_uid }}_{{ i }})">
                  <path d="M2.03172 8.68672C1.8146 8.7981 1.56822 8.60291 1.6121 8.35372L2.07897 5.6931L0.0972875 3.80535C-0.087775 3.62872 0.00841247 3.30585 0.256475 3.27097L3.0116 2.87947L4.2401 0.445537C4.35091 0.226162 4.65072 0.226162 4.76154 0.445537L5.99004 2.87947L8.74516 3.27097C8.99323 3.30585 9.08941 3.62872 8.90379 3.80535L6.92266 5.6931L7.38954 8.35372C7.43341 8.60291 7.18704 8.7981 6.96991 8.68672L4.49998 7.41772L2.03172 8.68672Z" fill="{% if i <= filled_stars %}#D7A040{% else %}#E7DDD8{% endif %}"/>
                </g>
                <defs>
                  <clipPath id="clip0_1568_13293_{{ card_uid }}_{{ i }}">
                    <rect width="9" height="9" fill="white"/>
                  </clipPath>
                </defs>
              </svg>
            </span>
          {% endfor %}
        </div>
        <small>{{ rating_count_number }} {% if rating_count_number == 1 %}reseña{% else %}reseñas{% endif %}</small>
      </div>
    {% endif %}
  </div>

  {% if eyebrow != blank %}
    <p class="santa-rita-product-card__eyebrow">{{ eyebrow }}</p>
  {% endif %}

  <h3>
    <a href="{{ product.url }}">{{ product.title }}</a>
  </h3>

  {% if location != blank %}
    <p class="santa-rita-product-card__origin">{{ location }}</p>
  {% endif %}

  {% form 'product', product, class: 'santa-rita-product-card__form', data-wsh-product-id: product.id %}
    <input type="hidden" name="quantity" value="1">

    <fieldset class="santa-rita-product-card__quantity-options" aria-label="Selecciona unidades">
      <legend class="visually-hidden">Selecciona unidades</legend>
      {{ presentation_options }}
    </fieldset>

    {% if liter_prices != blank %}
      <div class="santa-rita-product-card__liter-prices">
        {{ liter_prices }}
      </div>
    {% endif %}

    <button
      class="santa-rita-product-card__button"
      type="submit"
      {% unless product.available %}
        disabled
      {% endunless %}
    >
      {% if product.available %}
        Agregar al carro
      {% else %}
        Agotado
      {% endif %}
    </button>
  {% endform %}
  </article>
{% endunless %}
