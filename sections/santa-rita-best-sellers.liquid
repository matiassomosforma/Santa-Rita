  }

  @media screen and (max-width: 749px) {
    .content-for-layout[data-template='cart'] .santa-rita-best-sellers__container {
      padding: 34px 16px 44px;
    }

    .content-for-layout[data-template='cart'] .santa-rita-best-sellers__header {
      margin-bottom: 18px;
    }

    .content-for-layout[data-template='cart'] .santa-rita-best-sellers__header h2 {
      font-size: 20px;
    }

    .content-for-layout[data-template='cart'] .santa-rita-best-sellers__track {
      grid-auto-columns: calc((100% - 10px) / 1.5);
      gap: 10px;
    }

    .content-for-layout[data-template='cart'] .santa-rita-product-card {
      min-height: 303px;
    }

    .content-for-layout[data-template='cart'] .santa-rita-product-card__badges {
      display: none;
    }

    .content-for-layout[data-template='cart'] .santa-rita-product-card__media {
      min-height: 112px;
      margin-bottom: 9px;
      padding-top: 18px;
    }

    .content-for-layout[data-template='cart'] .santa-rita-product-card__image {
      height: 104px;
    }

    .content-for-layout[data-template='cart'] .santa-rita-product-card__rating {
      bottom: -4px;
      padding-inline: 8px;
      gap: 1px;
    }

    .content-for-layout[data-template='cart'] .santa-rita__star-group {
      gap: 0;
    }

    .content-for-layout[data-template='cart'] .santa-rita__star-group svg {
      width: 7px;
      height: 7px;
    }

    .content-for-layout[data-template='cart'] .santa-rita-product-card__rating small,
    .content-for-layout[data-template='cart'] .santa-rita-product-card__eyebrow,
    .content-for-layout[data-template='cart'] .santa-rita-product-card__origin {
      font-size: 8px;
      padding-inline: 8px;
    }

    .content-for-layout[data-template='cart'] .santa-rita-product-card__eyebrow {
      margin-bottom: 2px;
    }

    .content-for-layout[data-template='cart'] .santa-rita-product-card h3 {
      margin: 2px 0 2px;
      padding-inline: 8px;
      font-size: 10px;
    }

    .content-for-layout[data-template='cart'] .santa-rita-product-card__origin {
      padding-bottom: 7px;
      border-bottom: 1px solid rgba(110, 90, 97, 0.25);
    }

    .content-for-layout[data-template='cart'] .santa-rita-product-card__button {
      min-height: 28px;
      font-size: 9px;
    }

    .content-for-layout[data-template='cart'] .santa-rita-best-sellers__footer {
      justify-content: space-between;
      margin-top: 12px;
    }

    .content-for-layout[data-template='cart'] .santa-rita-best-sellers__arrows button {
      width: 28px;
      height: 28px;
    }

    .content-for-layout[data-template='cart'] .santa-rita-best-sellers__arrows button svg {
      width: 18px;
    }
  }
{% endstylesheet %}

