{% liquid
  assign step_blocks = section.blocks | where: 'type', 'step'
  assign button_url = section.settings.button_url | default: '/products/arma-tu-caja'
%}

{% if section.settings.show_section %}
  <section
    class="santa-rita-custom-box"
    style="
      --sr-custom-box-bg: {{ section.settings.background_color }};
      --sr-custom-box-text: {{ section.settings.text_color }};
      --sr-custom-box-accent: {{ section.settings.accent_color }};
      --sr-custom-box-panel-bg: {{ section.settings.panel_background_color }};
    "
    {{ section.shopify_attributes }}
  >
    <div class="santa-rita-custom-box__inner">
      {% if section.settings.heading != blank or section.settings.text != blank %}
        <div class="santa-rita-custom-box__header">
          {% if section.settings.heading != blank %}
            <h2>{{ section.settings.heading }}</h2>
          {% endif %}

          {% if section.settings.text != blank %}
            <p>{{ section.settings.text }}</p>
          {% endif %}
        </div>
      {% endif %}

      <article class="santa-rita-custom-box__panel">
        <div class="santa-rita-custom-box__icon" aria-hidden="true">
          {% if section.settings.icon_image != blank %}
            {{
              section.settings.icon_image
              | image_url: width: 96
              | image_tag:
                widths: '48, 64, 96',
                sizes: '48px',
                loading: 'lazy',
                class: 'santa-rita-custom-box__icon-image'
            }}
          {% else %}
            <svg viewBox="0 0 48 48" role="img">
              <path d="M11 16.5 24 10l13 6.5v15L24 38l-13-6.5v-15Z" fill="#f2ddd1"/>
              <path d="m11 16.5 13 6.5 13-6.5M24 23v15" fill="none" stroke="#9d1238" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
              <path d="M17 13.5v-3c0-1.1.9-2 2-2h2c1.1 0 2 .9 2 2v7M25 12.5v-3c0-1.1.9-2 2-2h2c1.1 0 2 .9 2 2v8" fill="none" stroke="#6d5750" stroke-linecap="round" stroke-width="2"/>
            </svg>
          {% endif %}
        </div>

        <div class="santa-rita-custom-box__content">
          {% if section.settings.card_heading != blank %}
            <h3>{{ section.settings.card_heading }}</h3>
          {% endif %}

          {% if step_blocks.size > 0 %}
            <ul class="santa-rita-custom-box__steps">
              {% for block in step_blocks %}
                {% if block.settings.text != blank %}
                  <li {{ block.shopify_attributes }}>
                    <span aria-hidden="true">
                      {{ 'icon-checkmark.svg' | inline_asset_content }}
                    </span>
                    {{ block.settings.text }}
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          {% endif %}
        </div>

        {% if section.settings.button_label != blank and button_url != blank %}
          <a class="santa-rita-custom-box__button" href="{{ button_url }}">
            {{ section.settings.button_label }}
          </a>
        {% endif %}
      </article>
    </div>
  </section>
{% endif %}

<style>
  .santa-rita-custom-box {
    background: var(--sr-custom-box-bg, #fffbf6);
    color: var(--sr-custom-box-text, #21000f);
  }

  .santa-rita-custom-box__inner {
    width: min(100% - 48px, 1140px);
    margin-inline: auto;
    padding-block: 46px 52px;
  }

  .santa-rita-custom-box__header {
    max-width: 520px;
    margin: 0 auto 28px;
    text-align: center;
  }

  .santa-rita-custom-box__header h2 {
    margin: 0 0 10px;
    font-family: var(--font-heading--family);
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: 0;
  }

  .santa-rita-custom-box__header p {
    max-width: 360px;
    margin: 0 auto;
    color: #2d2023;
    font-size: 14px;
    line-height: 1.25;
  }

  .santa-rita-custom-box__panel {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 18px;
    width: min(100%, 650px);
    margin-inline: auto;
    padding: 26px 32px;
    border: 1px solid rgba(157, 18, 56, 0.48);
    border-radius: 4px;
    background: var(--sr-custom-box-panel-bg, #fffbf6);
  }

  .santa-rita-custom-box__icon {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    border-radius: 50%;
    background: #f6e8df;
    overflow: hidden;
  }

  .santa-rita-custom-box__icon svg,
  .santa-rita-custom-box__icon-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .santa-rita-custom-box__content h3 {
    margin: 0 0 18px;
    color: #21000f;
    font-family: var(--font-body--family);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.25;
  }

  .santa-rita-custom-box__steps {
    display: grid;
    gap: 9px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .santa-rita-custom-box__steps li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    color: #21000f;
    font-size: 12px;
    line-height: 1.35;
  }

  .santa-rita-custom-box__steps span {
    display: inline-flex;
    width: 13px;
    height: 13px;
    flex: 0 0 13px;
    margin-top: 1px;
    color: var(--sr-custom-box-accent, #9d1238);
  }

  .santa-rita-custom-box__steps svg {
    width: 100%;
    height: 100%;
  }

  .santa-rita-custom-box__button {
    display: inline-flex;
    min-width: 156px;
    min-height: 37px;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: var(--sr-custom-box-accent, #9d1238);
    color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    padding: 8px 18px;
    text-align: center;
    text-decoration: none;
    transition: background-color 160ms ease;
  }

  .santa-rita-custom-box__button:hover {
    background: #7f0f2f;
    color: #ffffff;
  }

  @media screen and (max-width: 749px) {
    .santa-rita-custom-box__inner {
      width: calc(100% - 24px);
      padding-block: 32px 36px;
    }

    .santa-rita-custom-box__header {
      margin-bottom: 20px;
    }

    .santa-rita-custom-box__header h2 {
      font-size: 26px;
    }

    .santa-rita-custom-box__header p {
      font-size: 12px;
    }

    .santa-rita-custom-box__panel {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 12px;
      padding: 20px 18px;
    }

    .santa-rita-custom-box__icon {
      width: 42px;
      height: 42px;
      align-self: start;
    }

    .santa-rita-custom-box__button {
      grid-column: 1 / -1;
      width: 100%;
      margin-top: 8px;
    }
  }
</style>

{% schema %}
{
  "name": "SR caja personalizada",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Mostrar seccion",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titulo",
      "default": "Caja personalizada"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Puedes armar tu seleccion de 6 botellas en Santa Rita Online ideal para regalar y auto-regalarse."
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "Icono"
    },
    {
      "type": "text",
      "id": "card_heading",
      "label": "Titulo tarjeta",
      "default": "Crea tu propia caja"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto boton",
      "default": "Armar mi caja"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Link boton"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fondo seccion",
      "default": "#fffbf6"
    },
    {
      "type": "color",
      "id": "panel_background_color",
      "label": "Fondo tarjeta",
      "default": "#fffbf6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color texto",
      "default": "#21000f"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color acento",
      "default": "#9d1238"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Selecciona 6 botellas de vinos de preferencia."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SR caja personalizada",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "text": "Seleccionas 6 botellas de vinos de preferencia."
          }
        },
        {
          "type": "step",
          "settings": {
            "text": "La agregas al carrito, realizas el pedido y listo!"
          }
        }
      ]
    }
  ]
}
{% endschema %}
