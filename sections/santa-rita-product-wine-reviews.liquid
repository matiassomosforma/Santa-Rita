{% render 'santa-rita-product-wine-reviews' %}

<style>
  .santa-rita-wine-reviews {
    background: #fffbf6;
    color: #25171b;
    padding: 64px 20px 72px;
  }

  .santa-rita-wine-reviews__inner {
    max-width: 1120px;
    margin: 0 auto;
  }

  .santa-rita-wine-reviews__title {
    margin: 0 0 42px;
    font-family: var(--font-heading--family);
    font-size: 38px;
    font-weight: 700;
    line-height: 1.1;
    text-align: center;
  }

  .santa-rita-wine-reviews__widget {
    --jdgm-primary-color: #9d1238;
    --jdgm-secondary-color: #6d5762;
    --jdgm-border-color: rgba(37, 23, 27, 0.14);
    --jdgm-muted-color: rgba(37, 23, 27, 0.62);
    color: #25171b;
  }

  .santa-rita-wine-reviews__widget .jdgm-widget,
  .santa-rita-wine-reviews__widget .jdgm-rev-widg {
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font-family: var(--font-body--family);
  }

  .santa-rita-wine-reviews__widget .jdgm-rev-widg__title {
    display: none;
  }

  .santa-rita-wine-reviews__widget .jdgm-rev-widg__header {
    display: grid;
    max-width: 620px;
    align-items: center;
    grid-template-columns: 1fr 1.1fr auto;
    gap: 38px;
    margin: 0 auto 42px;
  }

  .santa-rita-wine-reviews__widget .jdgm-rev-widg__summary,
  .santa-rita-wine-reviews__widget .jdgm-histogram {
    min-height: 92px;
  }

  .santa-rita-wine-reviews__widget .jdgm-rev-widg__summary {
    display: grid;
    align-content: center;
    justify-items: end;
    border-right: 1px solid rgba(37, 23, 27, 0.18);
    padding: 0 32px 0 0;
  }

  .santa-rita-wine-reviews__widget .jdgm-rev-widg__summary-inner {
    display: grid;
    justify-items: end;
  }

  .santa-rita-wine-reviews__widget .jdgm-rev-widg__summary-average,
  .santa-rita-wine-reviews__widget .jdgm-rev-widg__summary-average span {
    color: var(--jdgm-primary-color);
    font-size: 28px;
    font-weight: 700;
    line-height: 1;
  }

  .santa-rita-wine-reviews__widget .jdgm-star,
  .santa-rita-wine-reviews__widget .jdgm-prev-badge__stars {
    color: #c22c58;
  }

  .santa-rita-wine-reviews__widget .jdgm-rev-widg__summary-stars {
    margin: 4px 0 0;
    line-height: 1;
  }

  .santa-rita-wine-reviews__widget .jdgm-rev-widg__summary-text {
    margin: 6px 0 0;
    color: var(--jdgm-muted-color);
    font-size: 13px;
    line-height: 1.2;
  }

  .santa-rita-wine-reviews__widget .jdgm-histogram {
    display: grid;
    align-content: center;
    gap: 8px;
    border-right: 1px solid rgba(37, 23, 27, 0.18);
    padding: 0 38px 0 0;
  }

  .santa-rita-wine-reviews__widget .jdgm-histogram__row {
    display: grid;
    align-items: center;
    grid-template-columns: 120px auto;
    gap: 8px;
    color: #25171b;
    font-size: 12px;
    line-height: 1;
  }

  .santa-rita-wine-reviews__widget .jdgm-histogram__bar {
    width: 120px;
    height: 5px;
    border-radius: 999px;
    background: #d4d2cf;
    box-shadow: none;
  }

  .santa-rita-wine-reviews__widget .jdgm-histogram__bar-content {
    height: 5px;
    border-radius: 999px;
    background: var(--jdgm-secondary-color);
  }

  .santa-rita-wine-reviews__widget .jdgm-histogram__frequency {
    display: none;
  }

  .santa-rita-wine-reviews__widget .jdgm-histogram__star {
    display: inline-flex;
    gap: 3px;
    color: #25171b;
  }

  .santa-rita-wine-reviews__widget .jdgm-write-rev-link,
  .santa-rita-wine-reviews__widget .jdgm-ask-question-btn,
  .santa-rita-wine-reviews__widget .jdgm-btn {
    min-height: 30px;
    border: 1px solid var(--jdgm-primary-color);
    border-radius: 999px;
    background: var(--jdgm-primary-color);
    color: #ffffff;
    cursor: pointer;
    font-family: var(--font-body--family);
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    padding: 8px 24px;
    text-decoration: none;
    text-transform: none;
  }

  .jdgm-form-wrapper .jdgm-btn,
  .jdgm-form-wrapper .jdgm-submit-rev,
  .jdgm-form-wrapper .jdgm-submit-question,
  .jdgm-form-wrapper input[type="submit"],
  .jdgm-form-wrapper button[type="submit"],
  .jdgm-write-review-modal .jdgm-write-review-modal__nav-btn,
  .jdgm-modal .jdgm-btn,
  .jdgm-modal button[type="button"],
  .jdgm-modal button[type="submit"],
  .jdgm-popup .jdgm-btn,
  .jdgm-popup button[type="button"],
  .jdgm-popup button[type="submit"],
  .jdgm-write-rev-link.jdgm-write-rev-link,
  .jdgm-btn.jdgm-btn {
    border-color: #9d1238;
    background-color: #9d1238;
    color: #ffffff;
  }

  .jdgm-form-wrapper .jdgm-btn:hover,
  .jdgm-form-wrapper .jdgm-submit-rev:hover,
  .jdgm-form-wrapper .jdgm-submit-question:hover,
  .jdgm-form-wrapper input[type="submit"]:hover,
  .jdgm-form-wrapper button[type="submit"]:hover,
  .jdgm-write-review-modal .jdgm-write-review-modal__nav-btn:hover,
  .jdgm-modal .jdgm-btn:hover,
  .jdgm-modal button[type="button"]:hover,
  .jdgm-modal button[type="submit"]:hover,
  .jdgm-popup .jdgm-btn:hover,
  .jdgm-popup button[type="button"]:hover,
  .jdgm-popup button[type="submit"]:hover,
  .jdgm-write-rev-link.jdgm-write-rev-link:hover,
  .jdgm-btn.jdgm-btn:hover {
    border-color: #7f0f2f;
    background-color: #7f0f2f;
    color: #ffffff;
  }

  .santa-rita-wine-reviews__widget .jdgm-rev-widg__sort-wrapper,
  .santa-rita-wine-reviews__widget .jdgm-sort-dropdown-wrapper,
  .santa-rita-wine-reviews__widget .jdgm-rev-widg__summary-text .jdgm-link {
    display: none;
  }

  .santa-rita-wine-reviews__widget .jdgm-rev-widg__body,
  .santa-rita-wine-reviews__widget .jdgm-rev-widg__reviews {
    border-top: 1px solid var(--jdgm-border-color);
  }

  .santa-rita-wine-reviews__widget .jdgm-rev {
    display: grid;
    align-items: center;
    grid-template-columns: 180px minmax(0, 1fr) 110px;
    gap: 36px;
    margin: 0;
    border: 0;
    border-bottom: 1px solid var(--jdgm-border-color);
    padding: 34px 110px;
  }

  .santa-rita-wine-reviews__widget .jdgm-rev__header {
    display: grid;
    gap: 8px;
  }

  .santa-rita-wine-reviews__widget .jdgm-rev__author {
    margin: 0;
    color: #25171b;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.2;
  }

  .santa-rita-wine-reviews__widget .jdgm-rev__buyer-badge,
  .santa-rita-wine-reviews__widget .jdgm-rev__buyer-badge-wrapper {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    width: fit-content;
    margin: 0;
    border: 0;
    background: transparent;
    color: #1f7a3c;
    font-size: 12px;
    line-height: 1.2;
    text-transform: none;
  }

  .santa-rita-wine-reviews__widget .jdgm-rev__buyer-badge::before,
  .santa-rita-wine-reviews__widget .jdgm-rev__buyer-badge-wrapper::before {
    display: grid;
    width: 13px;
    height: 13px;
    place-items: center;
    border-radius: 50%;
    background: #1f7a3c;
    color: #ffffff;
    content: "\2713";
    font-size: 9px;
    line-height: 1;
  }

  .santa-rita-wine-reviews__widget .jdgm-rev__content {
    display: grid;
    gap: 12px;
  }

  .santa-rita-wine-reviews__widget .jdgm-rev__rating {
    margin: 0;
    line-height: 1;
  }

  .santa-rita-wine-reviews__widget .jdgm-rev__title {
    margin: 0;
    color: #25171b;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
  }

  .santa-rita-wine-reviews__widget .jdgm-rev__body,
  .santa-rita-wine-reviews__widget .jdgm-rev__body p {
    margin: 0;
    color: var(--jdgm-muted-color);
    font-size: 13px;
    line-height: 1.35;
  }

  .santa-rita-wine-reviews__widget .jdgm-rev__timestamp {
    justify-self: end;
    color: #25171b;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.2;
  }

  .santa-rita-wine-reviews__widget .jdgm-rev__actions,
  .santa-rita-wine-reviews__widget .jdgm-rev__reply,
  .santa-rita-wine-reviews__widget .jdgm-rev__pics {
    grid-column: 2 / -1;
  }

  .santa-rita-wine-reviews__widget .jdgm-paginate {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin-top: 42px;
    border: 0;
  }

  .santa-rita-wine-reviews__widget .jdgm-paginate__page {
    color: #25171b;
    font-size: 14px;
    line-height: 1;
    text-decoration: none;
  }

  .santa-rita-wine-reviews__widget .jdgm-paginate__page.jdgm-curt,
  .santa-rita-wine-reviews__widget .jdgm-paginate__page[aria-current="page"] {
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    border-radius: 50%;
    background: var(--jdgm-primary-color);
    color: #ffffff;
    font-weight: 700;
  }

  .santa-rita-wine-reviews__widget .jdgm-paginate__prev-page,
  .santa-rita-wine-reviews__widget .jdgm-paginate__next-page {
    font-size: 28px;
  }

  .santa-rita-wine-reviews__widget .jdgm-paginate__prev-page {
    color: rgba(37, 23, 27, 0.28);
  }

  .santa-rita-wine-reviews__widget .jdgm-widget-actions-wrapper {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  @media screen and (max-width: 749px) {
    .santa-rita-wine-reviews {
      padding: 48px 18px 56px;
    }

    .santa-rita-wine-reviews__title {
      margin-bottom: 28px;
      font-size: 28px;
      text-align: left;
    }

    .santa-rita-wine-reviews__widget .jdgm-rev-widg__header {
      grid-template-columns: minmax(0, 1fr) minmax(108px, 0.8fr);
      gap: 20px;
      margin-bottom: 18px;
    }

    .santa-rita-wine-reviews__widget .jdgm-rev-widg__summary {
      min-height: 0;
      justify-items: start;
      border-right: 0;
      padding-right: 0;
    }

    .santa-rita-wine-reviews__widget .jdgm-rev-widg__summary-inner {
      justify-items: start;
    }

    .santa-rita-wine-reviews__widget .jdgm-rev-widg__summary-average,
    .santa-rita-wine-reviews__widget .jdgm-rev-widg__summary-average span {
      font-size: 28px;
    }

    .santa-rita-wine-reviews__widget .jdgm-histogram {
      min-height: 0;
      border-right: 0;
      padding-right: 0;
    }

    .santa-rita-wine-reviews__widget .jdgm-histogram__row {
      grid-template-columns: minmax(64px, 1fr) auto;
    }

    .santa-rita-wine-reviews__widget .jdgm-histogram__bar {
      width: 100%;
    }

    .santa-rita-wine-reviews__widget .jdgm-widget-actions-wrapper {
      justify-content: flex-start;
      grid-column: 1 / -1;
    }

    .santa-rita-wine-reviews__widget .jdgm-write-rev-link,
    .santa-rita-wine-reviews__widget .jdgm-ask-question-btn,
    .santa-rita-wine-reviews__widget .jdgm-btn {
      min-width: 156px;
      font-size: 14px;
      padding-inline: 22px;
    }

    .santa-rita-wine-reviews__widget .jdgm-rev-widg__body,
    .santa-rita-wine-reviews__widget .jdgm-rev-widg__reviews {
      border-top: 0;
    }

    .santa-rita-wine-reviews__widget .jdgm-rev {
      grid-template-columns: 1fr auto;
      gap: 14px;
      border-bottom: 0;
      padding: 20px 0 0;
    }

    .santa-rita-wine-reviews__widget .jdgm-rev:nth-of-type(n + 2) {
      display: none;
    }

    .santa-rita-wine-reviews__widget .jdgm-rev__header {
      grid-column: 1;
    }

    .santa-rita-wine-reviews__widget .jdgm-rev__timestamp {
      align-self: start;
      grid-column: 2;
      font-size: 13px;
      font-weight: 500;
    }

    .santa-rita-wine-reviews__widget .jdgm-rev__content {
      grid-column: 1 / -1;
    }

    .santa-rita-wine-reviews__widget .jdgm-rev__body,
    .santa-rita-wine-reviews__widget .jdgm-rev__body p {
      font-size: 13px;
    }

    .santa-rita-wine-reviews__widget .jdgm-paginate {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "SR opiniones vino",
  "settings": [],
  "presets": [
    {
      "name": "Santa Rita opiniones vino"
    }
  ]
}
{% endschema %}
