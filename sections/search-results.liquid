

<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<results-list
  class="section product-grid-container product-grid-container--santa-rita santa-rita-search-results spacing-style color-{{ section.settings.color_scheme }}"
  style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
  section-id="{{ section.id }}"
  infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
>
  {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

  <div
    class="collection-wrapper grid gap-style"
  >
    {% assign products_per_page = 24 %}

    {% if section.settings.enable_infinite_scroll == false %}
      {% assign products_per_page = section.settings.products_per_page %}
    {% endif %}

    {% paginate search.results by products_per_page %}
      {% if search.results_count > 0 %}
        {% content_for 'block', type: 'filters', id: 'filters', results: search, results_size: search.results_count %}
        {% assign products = search.results | where: 'object_type', 'product' %}
      {% else %}
        {% assign collection = settings.empty_state_collection | default: collections.all %}
        {% assign default_title = 'content.search_results_resource_products' | t %}
        {% assign title = settings.empty_state_collection.title | default: default_title %}
        {% assign products = collection.products %}
      {% endif %}

      {% capture children %}
        {% for product in products %}
          {% liquid
            assign product_type_downcase = product.type | downcase
            assign is_tour_product = false

            if product_type_downcase contains 'tour' or product.tags contains 'tour' or product.tags contains 'Tour'
              assign is_tour_product = true
            endif
          %}

          {% unless is_tour_product %}
            <li
              id="{{ section.id }}-{{ product.id }}"
              class="product-grid__item product-grid__item--{{ forloop.index0 }}"
              data-page="{{ paginate.current_page }}"
              data-product-id="{{ product.id }}"
              ref="cards[]"
            >
              {% render 'santa-rita-best-seller-card',
                product: product,
                section_settings: section.settings
              %}
            </li>
          {% endunless %}
        {% endfor %}
      {% endcapture %}

      {% render 'product-grid',
        section: section,
        children: children,
        products: products,
        paginate: paginate,
        enable_infinite_scroll: section.settings.enable_infinite_scroll,
        title: title
      %}
    {% endpaginate %}
  </div>
</results-list>

{% stylesheet %}
  .santa-rita-search-results {
    background: #fffbf6;
  }

  .santa-rita-search-results .collection-wrapper {
    row-gap: 0;
  }

  .santa-rita-search-results .facets.facets-controls-wrapper {
    grid-column: var(--centered);
    justify-content: space-between;
    padding-block: 18px 22px;
  }

  .santa-rita-search-results grid-density-controls {
    display: none;
  }

  .santa-rita-search-results .products-count-wrapper,
  .santa-rita-search-results .sorting-filter .facets__label,
  .santa-rita-search-results .sorting-filter .facets__status {
    color: #6e5a61;
    font-family: var(--font-body--family);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.2;
  }

  .santa-rita-search-results .sorting-filter .facets__summary {
    min-height: auto;
    gap: 4px;
    padding: 0;
    border: 0;
    background: transparent;
    color: #21000f;
    line-height: 1.2;
  }

  .santa-rita-search-results .sorting-filter .facets__status {
    display: none;
  }

  .santa-rita-search-results .sorting-filter .icon-caret {
    width: 10px;
    height: 10px;
    margin: 0;
  }

  .santa-rita-search-results .facets--filters-title,
  .santa-rita-search-results .facets__filters-wrapper > .filter-remove-buttons {
    display: none;
  }

  .santa-rita-search-results .facets__filters-wrapper,
  .santa-rita-search-results .facets__overflow-list,
  .santa-rita-search-results overflow-list,
  .santa-rita-search-results .facets__form {
    gap: 12px;
  }

  .santa-rita-search-results .facets__summary {
    min-height: 36px;
    padding: 0 18px;
    border: 1px solid #21000f;
    border-radius: 999px;
    background: #fffbf6;
    color: #21000f;
    font-size: 14px;
    line-height: 1;
  }

  .santa-rita-search-results .facets__summary[aria-expanded='true'] {
    background: #21000f;
    color: #ffffff;
  }

  .santa-rita-search-results .product-grid {
    align-items: stretch;
    gap: 28px 24px;
  }

  .santa-rita-search-results .santa-rita-product-card {
    position: relative;
    display: flex;
    min-height: 472px;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid #fff;
    border-radius: 12px;
    background: #ffffff;
    box-shadow: 0 0 2px 0 rgba(140, 26, 62, 0.13) inset, 0 10px 10px 0 rgba(140, 26, 62, 0.05);
    transition: all 0.3s ease;
  }

  .santa-rita-search-results .santa-rita-product-card:hover {
    box-shadow: 0 0 2px 0 rgb(140 26 62 / 41%) inset, 0 10px 10px 0 rgb(140 26 62 / 19%);
  }

  .santa-rita-search-results .santa-rita-product-card__badges {
    position: absolute;
    inset: 14px 14px auto;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
  }

  .santa-rita-search-results .santa-rita-product-card__badge {
    display: inline-flex;
    min-width: 50px;
    min-height: 25px;
    align-items: center;
    justify-content: center;
    padding: 0 12px;
    border: 1px solid #aea2a6;
    border-radius: 12px;
    background: #f5f4ed;
    color: #21000f;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
  }

  .santa-rita-search-results .santa-rita-product-card__badge--discount {
    border-color: #9b173f;
    background: #9b173f;
    color: #ffffff;
  }

  .santa-rita-search-results .santa-rita-product-card__badge--blank {
    opacity: 0;
  }

  .santa-rita-search-results .santa-rita__product-image {
    position: relative;
  }

  .santa-rita-search-results .santa-rita-product-card__media {
    position: relative;
    display: grid;
    min-height: 184px;
    place-items: end center;
    margin-bottom: 32px;
    padding-top: 32px;
    text-decoration: none;
  }

  .santa-rita-search-results .santa-rita-product-card__image {
    width: auto;
    max-width: 78%;
    height: 180px;
    object-fit: contain;
  }

  .santa-rita-search-results .santa-rita-product-card__image--placeholder {
    opacity: 0.65;
    filter: none;
  }

  .santa-rita-search-results .santa-rita__star-group {
    display: flex;
    gap: 2px;
  }

  .santa-rita-search-results .santa-rita-product-card__rating {
    position: absolute;
    right: 0;
    bottom: 5px;
    display: flex;
    min-height: 24px;
    flex-direction: column;
    align-items: flex-end;
    justify-content: flex-end;
    gap: 6px;
    padding-inline: 16px;
    color: #c98d00;
    font-size: 12px;
    line-height: 1;
  }

  .santa-rita-search-results .santa-rita-product-card__rating small {
    color: #6e5a61;
    font-size: 12px;
  }

  .santa-rita-search-results .santa-rita-product-card__eyebrow,
  .santa-rita-search-results .santa-rita-product-card__origin {
    margin: 0;
    padding-inline: 16px;
    color: #8d183f;
    font-size: 12px;
    line-height: 1.25;
  }

  .santa-rita-search-results .santa-rita-product-card h3 {
    margin: 7px 0 4px;
    padding-inline: 16px;
    color: #2b1e1e;
    font-family: var(--font-heading--family);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: 0;
  }

  .santa-rita-search-results .santa-rita-product-card h3 a {
    color: inherit;
    text-decoration: none;
  }

  .santa-rita-search-results .santa-rita-product-card__origin {
    margin-top: 3px;
    color: #6b5d5d;
  }

  .santa-rita-search-results .santa-rita-product-card__form {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: auto 0 0;
    padding: 16px;
  }

  .santa-rita-search-results .santa-rita-product-card__quantity-options {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 16px 0 0;
    border: 0;
    border-top: 0.5px solid rgba(110, 90, 97, 0.35);
  }

  .santa-rita-search-results .santa-rita-product-card__quantity-option {
    position: relative;
  }

  .santa-rita-search-results .santa-rita-product-card__quantity-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .santa-rita-search-results .santa-rita-product-card__quantity-label {
    display: grid;
    min-height: 41px;
    grid-template-columns: auto auto auto minmax(0, 1fr);
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border: 1px solid #eee8e2;
    border-radius: 6px;
    background: #f5f1eb;
    color: #1e0812;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .santa-rita-search-results .santa-rita-product-card__quantity-radio:checked + .santa-rita-product-card__quantity-label {
    border-color: #9b173f;
    background: #fff8f9;
  }

  .santa-rita-search-results .santa-rita-product-card__quantity-radio:focus-visible + .santa-rita-product-card__quantity-label {
    outline: 2px solid #9b173f;
    outline-offset: 2px;
  }

  .santa-rita-search-results .santa-rita-product-card__quantity-count {
    min-width: 42px;
    color: #2b1e1e;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
  }

  .santa-rita-search-results .santa-rita-product-card__quantity-price {
    color: #1e0812;
    font-size: 16px;
    font-weight: 800;
    line-height: 1;
    white-space: nowrap;
  }

  .santa-rita-search-results .santa-rita-product-card__quantity-compare {
    color: #7d6e73;
    font-size: 12px;
    line-height: 1;
    white-space: nowrap;
  }

  .santa-rita-search-results .santa-rita-product-card__quantity-check {
    display: inline-flex;
    grid-column: 4;
    justify-self: end;
    width: 14px;
    height: 14px;
    color: #9b173f;
    opacity: 0;
  }

  .santa-rita-search-results .santa-rita-product-card__quantity-radio:checked + .santa-rita-product-card__quantity-label .santa-rita-product-card__quantity-check {
    opacity: 1;
  }

  .santa-rita-search-results .santa-rita-product-card__liter-price {
    margin: 0;
    padding-top: 10px;
    border-top: 0.5px solid rgba(110, 90, 97, 0.35);
    color: #6e5a61;
    font-size: 12px;
    line-height: 1.25;
  }

  .santa-rita-search-results .santa-rita-product-card__liter-price strong {
    color: #6e5a61;
    font-weight: 800;
  }

  .santa-rita-search-results .santa-rita-product-card__button {
    width: 100%;
    min-height: 44px;
    margin: 0;
    border: 1px solid #8c1a3e;
    border-radius: 7px;
    background: #8c1a3e;
    color: #ffffff;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .santa-rita-search-results .santa-rita-product-card__button:hover {
    background: #ffffff;
    color: #8c1a3e;
  }

  .santa-rita-search-results .santa-rita-product-card__button:disabled {
    opacity: 0.55;
    cursor: default;
  }

  @media screen and (min-width: 990px) {
    .santa-rita-search-results .product-grid {
      --product-grid-columns-desktop: repeat(4, minmax(0, 1fr));
      grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    }
  }

  @media screen and (max-width: 989px) and (min-width: 750px) {
    .santa-rita-search-results .product-grid {
      --product-grid-columns-desktop: repeat(3, minmax(0, 1fr));
      grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    }
  }

  @media screen and (max-width: 749px) {
    .santa-rita-search-results .facets.facets-controls-wrapper {
      grid-column: var(--full-width);
      padding: 12px var(--page-margin);
    }

    .santa-rita-search-results .product-grid {
      gap: 16px 12px;
    }

    .santa-rita-search-results .santa-rita-product-card {
      min-height: 450px;
    }

    .santa-rita-search-results .santa-rita-product-card__quantity-label {
      grid-template-columns: auto minmax(0, auto) minmax(0, auto) minmax(14px, 1fr);
      gap: 6px;
      padding-inline: 8px;
    }

    .santa-rita-search-results .santa-rita-product-card__quantity-count {
      min-width: 34px;
    }

    .santa-rita-search-results .santa-rita-product-card__quantity-price {
      font-size: 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.search_results",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.edit_empty_state_collection_in_theme_settings"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24,
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": []
}
{% endschema %}
